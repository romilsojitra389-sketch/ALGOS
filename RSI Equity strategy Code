for symbol, token in nifty50_tokens.items():
    try:
        if len(open_positions) >= MAX_POSITIONS:
            break

        df = get_data(symbol, token)

        if df is None or len(df) < 50:
            continue

        idx = len(df) - 1

        prev_rsi = calculate_rsi(df.iloc[:idx]["close"])
        curr_rsi = calculate_rsi(df.iloc[:idx+1]["close"])

        # ===== ENTRY =====
        if prev_rsi < 30 and curr_rsi > 30:

            if symbol not in open_positions:

                ltp = get_ltp(symbol, token)
                if not ltp:
                    continue

                qty = math.floor(CAPITAL_PER_TRADE / ltp)
                if qty == 0:
                    continue

                sl = ltp * 0.98

                place_order(symbol, token, qty)

                print(f"\n🛒 BUY: {symbol}")
                print(f"Qty: {qty} | Price: {ltp} | SL: {round(sl,2)}")

                log_entry(symbol, ltp, qty, sl)
                open_positions[symbol] = {"entry": ltp, "qty": qty, "sl": sl}

        # ===== EXIT =====
        if symbol in open_positions:

            ltp = get_ltp(symbol, token)
            if not ltp:
                continue

            df = get_data(symbol, token)
            if df is None:
                continue

            idx = len(df) - 1

            prev_rsi = calculate_rsi(df.iloc[:idx]["close"])
            curr_rsi = calculate_rsi(df.iloc[:idx+1]["close"])

            entry = open_positions[symbol]["entry"]
            sl = open_positions[symbol]["sl"]

            if ltp <= sl or (prev_rsi <= 50 and curr_rsi > 50):

                print(f"\n❌ EXIT: {symbol}")
                print(f"RSI Exit → {prev_rsi} → {curr_rsi}")

                log_exit(symbol, ltp)
                del open_positions[symbol]

        time.sleep(0.7)

    except Exception as e:
        print(f"Error {symbol}: {e}")
        time.sleep(1)

