# ===== RSI =====
def calculate_rsi(close):
    delta = close.diff()

    gain = delta.clip(lower=0)
    loss = -delta.clip(upper=0)

    avg_gain = round(gain.iloc[1:15].mean(), 6)
    avg_loss = round(loss.iloc[1:15].mean(), 6)

    for i in range(15, len(close)):
        avg_gain = ((avg_gain * 13) + round(gain.iloc[i],6)) / 14
        avg_loss = ((avg_loss * 13) + round(loss.iloc[i],6)) / 14
        avg_gain = round(avg_gain, 6)
        avg_loss = round(avg_loss, 6)

    if avg_loss == 0:
        return 100

    rs = avg_gain / avg_loss
    return round(100 - (100 / (1 + rs)), 2)

# ===== FETCH DATA =====
def get_data(symbol, token):
    try:
        params = {
            "exchange": "NSE",
            "symboltoken": token,
            "interval": "ONE_HOUR",
            "fromdate": (datetime.now() - timedelta(days=20)).strftime("%Y-%m-%d %H:%M"),
            "todate": datetime.now().strftime("%Y-%m-%d %H:%M")
        }

        data = obj.getCandleData(params)

        if "data" not in data or data["data"] is None:
            return None

        df = pd.DataFrame(data["data"], columns=[
            "timestamp","open","high","low","close","volume"
        ])

        df["close"] = pd.to_numeric(df["close"], errors="coerce")
        return df.dropna()

    except:
        time.sleep(2)
        return None

# ===== ORDER =====
def place_order(symbol, token, qty):
    orderparams = {
        "variety": "NORMAL",
        "tradingsymbol": symbol + "-EQ",
        "symboltoken": token,
        "transactiontype": "BUY",
        "exchange": "NSE",
        "ordertype": "MARKET",
        "producttype": "DELIVERY",
        "duration": "DAY",
        "price": "0",
        "quantity": str(qty)
    }
    return obj.placeOrder(orderparams)

# ===== LTP =====
def get_ltp(symbol, token):
    try:
        data = obj.ltpData("NSE", symbol + "-EQ", token)
        return float(data["data"]["ltp"])
    except:
        return None

# ===== LOG ENTRY =====
def log_entry(symbol, price, qty, sl):
    global trade_df
    new_row = {
        "symbol": symbol,
        "entry_price": price,
        "qty": qty,
        "sl": sl,
        "entry_time": datetime.now(),
        "exit_price": "",
        "exit_time": "",
        "pnl": "",
        "position": 1
    }
    trade_df = pd.concat([trade_df, pd.DataFrame([new_row])])
    trade_df.to_csv(CSV_FILE, index=False)

# ===== LOG EXIT =====
def log_exit(symbol, price):
    global trade_df

    idx = trade_df[
        (trade_df["symbol"] == symbol) &
        (trade_df["position"] == 1)
    ].index[-1]

    entry_price = float(trade_df.loc[idx, "entry_price"])
    qty = float(trade_df.loc[idx, "qty"])

    pnl = (price - entry_price) * qty

    trade_df.loc[idx, "exit_price"] = price
    trade_df.loc[idx, "exit_time"] = datetime.now()
    trade_df.loc[idx, "pnl"] = pnl
    trade_df.loc[idx, "position"] = 0

    trade_df.to_csv(CSV_FILE, index=False)

